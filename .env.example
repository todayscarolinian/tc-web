# Herald SSO — see src/lib/herald/README.md
HERALD_INTERNAL_API_KEY="herald-internal-api-key"
NEXT_PUBLIC_HERALD_AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_HERALD_CORE_URL="http://localhost:3002"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Firebase Admin SDK — service account credentials for a Firebase project
# with Firestore + Storage enabled. Generate via Firebase Console > Project
# Settings > Service Accounts > Generate new private key.
# See src/infrastructure/firebase/admin.ts.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
# Keep the surrounding quotes and literal "\n" sequences — admin.ts unescapes
# them at runtime. Most hosts (Vercel included) mangle real newlines in env
# var UIs, so the private key is stored single-line with escaped newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="your-firebase-project-id.appspot.com"

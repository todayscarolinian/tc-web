# Herald SSO — see src/lib/herald/README.md
HERALD_INTERNAL_API_KEY="herald-internal-api-key"
NEXT_PUBLIC_HERALD_AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_HERALD_CORE_URL="http://localhost:3002"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Firebase Admin SDK — service account credentials for a Firebase project
# with Firestore + Storage enabled. Generate via Firebase Console > Project
# Settings > Service Accounts > Generate new private key.
# See src/infrastructure/firebase/admin.ts.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
# Keep the surrounding quotes and literal "\n" sequences — admin.ts unescapes
# them at runtime. Most hosts (Vercel included) mangle real newlines in env
# var UIs, so the private key is stored single-line with escaped newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="your-firebase-project-id.appspot.com"

# GA4 Data API — spike-only, see docs/adr/ga4-analytics-spike-findings.md and
# scripts/ga4-test-query.ts. Separate service account from Firebase Admin SDK
# above, granted Viewer on the GA4 property (Property Access Management —
# Firebase project access alone does not grant GA4 reporting access).
GA4_PROPERTY_ID="your-ga4-property-id"
GA4_CLIENT_EMAIL="ga4-data-api-reader@your-gcp-project-id.iam.gserviceaccount.com"
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Analytics 4 Measurement ID for the site. Used by the GA4 gtag.js snippet
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Feature flags — see src/lib/flags.ts
# Real analytics (dashboard charts, Top Stories/Most Read rails) deferred
# post-MVP. Flip to "true" once there's ~30 days of real production traffic.
ENABLE_ANALYTICS="false"
